# Copy to .env locally. In production, configure these through your hosting provider's secret manager.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Local admin bootstrap: leave ADMIN_PASSWORD empty to create the first admin at /admin.
# Production requires an explicit, unique username and a strong password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Generate a random secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=InsulationPortfolio
JWT_AUDIENCE=InsulationPortfolio.Admin
JWT_EXPIRY_MINUTES=480

# Use persistent storage paths on your deployment host.
DB_PATH=./data/manee_portfolio.db
STORAGE_ROOT_PATH=./data/uploads

# Optional: comma-separated exact origins, for example https://www.example.com,https://example.com
CORS_ALLOWED_ORIGINS=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=MANEE | مَنيع
SMTP_USE_STARTTLS=true

# Keep disabled in production unless API documentation is intentionally public.
SWAGGER_ENABLED=false
